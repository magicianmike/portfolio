---
import { Image } from 'astro:assets'
import headshot from '../assets/about/headshot.jpg'
import { navigation } from '../navigation'
import ThemeToggle from './ThemeToggle.astro'

/** A page's own link says so; Work is a section of the home page, so it isn't marked. */
const here = (href: string) => (href === Astro.url.pathname.replace(/\/$/, '') ? 'page' : undefined)
---

<header class="flex flex-wrap items-center justify-between gap-4 py-6 print:hidden">
  <a href="/" class="font-display inline-flex items-center gap-3 text-xl font-extrabold no-underline">
    <!-- Decorative: the name beside it says who it is, and the About page has the photo with its description. -->
    <Image
      src={headshot}
      alt=""
      width={40}
      height={40}
      densities={[1, 2]}
      fit="cover"
      position="top"
      loading="eager"
      class="border-edge size-10 rounded-full border"
    />
    Mikel McCormick
  </a>
  <div class="flex items-center gap-4 sm:gap-5">
    <nav aria-label="Main">
      <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0 font-medium sm:gap-x-5">
        {navigation.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={here(href)}
              class="no-underline hover:underline aria-[current=page]:underline aria-[current=page]:decoration-pen aria-[current=page]:decoration-2"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
