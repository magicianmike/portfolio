---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  shot: { light: ImageMetadata; dark: ImageMetadata; alt: string }
  /** The rendered widths it's served at, for the browser to choose from. */
  widths: number[]
  sizes: string
  /**
   * The page's main image. The light capture loads at once, at high priority. The dark one stays lazy: hidden, a lazy
   * image is never fetched, so a page loads only the capture its theme shows, at the cost of a moment's wait in dark.
   */
  eager?: boolean
  class?: string
}

const { shot, widths, sizes, eager = false, class: className } = Astro.props
// A phone's screenshot is tall: shown at a phone's width, not stretched to the column.
const portrait = shot.light.height > shot.light.width
---

<div
  class:list={[
    'border-edge bg-card overflow-hidden rounded-sm border shadow-sm',
    portrait && 'w-full max-w-72',
    className,
  ]}
>
  <Image
    src={shot.light}
    alt={shot.alt}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class="shot-light w-full"
  />
  <Image src={shot.dark} alt={shot.alt} widths={widths} sizes={sizes} loading="lazy" class="shot-dark w-full" />
</div>
