---
import type { CollectionEntry } from 'astro:content'
import MarginNote from './MarginNote.astro'
import Screenshot from './Screenshot.astro'

interface Props {
  project: CollectionEntry<'projects'>
}

const { id, data } = Astro.props.project
const href = `/projects/${id}`
---

<!-- On a phone the dashed rule goes above the note, so the note opens its Project rather than closing the last. -->
<div class="border-edge col-span-full grid grid-cols-subgrid border-t border-dashed md:border-t-0">
  <MarginNote arrow>{data.note}</MarginNote>
  <article class="border-edge grid gap-6 pt-3 pb-10 md:col-start-2 md:border-t md:border-dashed md:pt-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-start">
    <Screenshot shot={data.hero} widths={[480, 720, 960]} sizes="(min-width: 64rem) 32rem, 100vw" />
    <div class="grid gap-4">
      <h3 class="m-0 text-3xl leading-none font-extrabold tracking-tight md:text-4xl">
        <a href={href} class="no-underline hover:underline">
          {data.name}
        </a>
      </h3>
      <p class="m-0 text-lg leading-relaxed">{data.pitch}</p>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label={`${data.name}: stack`}>
        {data.stack.map((item) => (
          <li class="border-edge bg-card rounded-sm border px-2 py-0.5 text-sm">{item}</li>
        ))}
      </ul>
      <a href={href} class="decoration-pen inline-flex min-h-11 items-center font-semibold decoration-2">
        Read about {data.name}
      </a>
    </div>
  </article>
</div>
