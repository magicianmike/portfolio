---
import type { CollectionEntry } from 'astro:content'
import Icon from './Icon.astro'
import MarginNote from './MarginNote.astro'
import Screenshot from './Screenshot.astro'

interface Props {
  project: CollectionEntry<'projects'>
}

const { id, data } = Astro.props.project
const href = `/projects/${id}`
// Its Case Study, live site and code. The Portfolio site has no live site: it would only point at the page you're on.
// A link to another site opens in a new tab and says so; the Portfolio site's own Case Study opens here.
const links = [
  { label: 'Case Study', icon: 'case-study', href: data.links.caseStudy },
  { label: 'Live site', icon: 'live', href: data.links.live },
  { label: 'GitHub', icon: 'github', href: data.links.code },
] as const
const shown = links.flatMap(({ href, ...link }) => (href ? [{ ...link, href, newTab: /^https?:/.test(href) }] : []))
---

<!-- On a phone the dashed rule goes above the note, so the note opens its Project rather than closing the last. -->
<div class="border-divider col-span-full grid grid-cols-subgrid border-t-2 border-dashed md:border-t-0">
  <MarginNote arrow>{data.note}</MarginNote>
  <article class="border-divider grid gap-6 pt-3 pb-16 md:col-start-2 md:border-t-2 md:border-dashed md:pt-8 md:pb-24 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-start">
    {data.links.live ? (
      // The screenshot opens the live site too. Its name says so, rather than reading out the screenshot's description.
      <a
        href={data.links.live}
        aria-label={`${data.name}, the live site (opens in a new tab)`}
        target="_blank"
        rel="noopener"
        class="group block"
      >
        <Screenshot
          shot={data.hero}
          widths={[480, 720, 960]}
          sizes="(min-width: 64rem) 32rem, 100vw"
          class="transition-shadow group-hover:shadow-md motion-reduce:transition-none"
        />
      </a>
    ) : (
      <Screenshot shot={data.hero} widths={[480, 720, 960]} sizes="(min-width: 64rem) 32rem, 100vw" />
    )}
    <div class="grid gap-4">
      <h3 class="m-0 text-3xl leading-none font-extrabold tracking-tight md:text-4xl">
        <a href={href} class="no-underline hover:underline">
          {data.name}
        </a>
      </h3>
      <p class="m-0 text-lg leading-relaxed">{data.pitch}</p>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label={`${data.name}: stack`}>
        {data.stack.map((item) => (
          <li class="border-edge bg-card rounded-sm border px-2 py-0.5 text-sm">{item}</li>
        ))}
      </ul>
      <p class="m-0 flex flex-wrap gap-x-6">
        {shown.map(({ label, icon, href, newTab }) => (
          <a
            href={href}
            aria-label={`${label}: ${data.name}${newTab ? ' (opens in a new tab)' : ''}`}
            target={newTab ? '_blank' : undefined}
            rel={newTab ? 'noopener' : undefined}
            class="decoration-pen inline-flex min-h-11 items-center gap-2 font-semibold decoration-2"
          >
            <Icon name={icon} />
            {label}
          </a>
        ))}
      </p>
    </div>
  </article>
</div>
