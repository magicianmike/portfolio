---
import type { CollectionEntry } from 'astro:content'
import Icon from './Icon.astro'
import MarginNote from './MarginNote.astro'
import Screenshot from './Screenshot.astro'

interface Props {
  project: CollectionEntry<'projects'>
}

const { id, data } = Astro.props.project
const href = `/projects/${id}`
// Its Case Study, live site and code. The Portfolio site has no live site: it would only point at the page you're on.
// A link to another site opens in a new tab and says so; the Portfolio site's own Case Study opens here.
const links = [
  { label: 'Case Study', icon: 'case-study', href: data.links.caseStudy },
  { label: 'Live site', icon: 'live', href: data.links.live },
  { label: 'GitHub', icon: 'github', href: data.links.code },
] as const
const shown = links.flatMap(({ href, ...link }) => (href ? [{ ...link, href, newTab: /^https?:/.test(href) }] : []))
---

<!--
  On a phone each Project is a card, its note taped across the top, its name above the screenshot and its links a row
  of buttons. Wider, the note moves to the margin and the Project sits between dashed rules.
-->
<div class="col-span-full grid grid-cols-subgrid pt-4 pb-8 md:p-0">
  <MarginNote arrow taped>
    {data.note}
  </MarginNote>
  <article class="border-edge bg-card md:border-divider grid gap-4 rounded-sm border px-4 pt-8 pb-5 shadow-md md:col-start-2 md:gap-6 md:rounded-none md:border-0 md:border-t-2 md:border-dashed md:bg-transparent md:px-0 md:pt-8 md:pb-24 md:shadow-none lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-start">
    {data.links.live ? (
      // The screenshot opens the live site too. Its name says so, rather than reading out the screenshot's description.
      <a
        href={data.links.live}
        aria-label={`${data.name}, the live site (opens in a new tab)`}
        target="_blank"
        rel="noopener"
        class="group block"
      >
        <Screenshot
          shot={data.hero}
          widths={[480, 720, 960]}
          sizes="(min-width: 64rem) 32rem, 100vw"
          class="transition-shadow group-hover:shadow-md motion-reduce:transition-none"
        />
      </a>
    ) : (
      <Screenshot shot={data.hero} widths={[480, 720, 960]} sizes="(min-width: 64rem) 32rem, 100vw" />
    )}
    <!-- On a phone its parts join the card's grid, so the name can go above the screenshot. -->
    <div class="contents md:grid md:gap-4">
      <h3 class="order-first m-0 text-3xl leading-none font-extrabold tracking-tight md:order-none md:text-4xl">
        <a href={href} class="no-underline hover:underline">
          {data.name}
        </a>
      </h3>
      <p class="m-0 text-base leading-relaxed md:text-lg">{data.pitch}</p>
      <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0 md:gap-2" aria-label={`${data.name}: stack`}>
        {data.stack.map((item) => (
          <li class="border-edge bg-paper md:bg-card rounded-sm border px-1.5 py-0.5 text-xs md:px-2 md:text-sm">
            {item}
          </li>
        ))}
      </ul>
      <p
        class:list={[
          'border-edge divide-edge m-0 grid divide-x overflow-hidden rounded-md border md:flex md:flex-wrap md:gap-x-6 md:divide-x-0 md:overflow-visible md:rounded-none md:border-0',
          shown.length === 3 ? 'grid-cols-3' : 'grid-cols-2',
        ]}
      >
        {shown.map(({ label, icon, href, newTab }) => (
          <a
            href={href}
            aria-label={`${label}: ${data.name}${newTab ? ' (opens in a new tab)' : ''}`}
            target={newTab ? '_blank' : undefined}
            rel={newTab ? 'noopener' : undefined}
            class="decoration-pen hover:bg-paper inline-flex min-h-14 flex-col items-center justify-center gap-1 py-2 text-sm font-semibold no-underline decoration-2 md:min-h-11 md:flex-row md:justify-start md:gap-2 md:py-0 md:text-base md:underline md:hover:bg-transparent"
          >
            <Icon name={icon} class="max-md:size-5" />
            {label}
          </a>
        ))}
      </p>
    </div>
  </article>
</div>
