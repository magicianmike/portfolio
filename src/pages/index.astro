---
import { getCollection } from 'astro:content'
import MarginNote from '../components/MarginNote.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Base from '../layouts/Base.astro'

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
---

<Base
  title="Mikel McCormick"
  description="Mikel McCormick, product-minded frontend engineer: projects, case studies and how they were made."
>
  <!--
    Arriving from another page's Work link, the page would jump straight to #work. Instead it opens at the top and
    glides down, as it does when Work is clicked here. Without JavaScript, or with less motion asked for, it jumps.
  -->
  <script is:inline>
    if (location.hash === '#work' && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      history.replaceState(null, '', location.pathname)
      addEventListener('load', () => {
        history.replaceState(null, '', '#work')
        document.getElementById('work').scrollIntoView({ behavior: 'smooth' })
      })
    }
  </script>
  <MarginNote arrow>hi, I'm Mikel</MarginNote>
  <div class="grid max-w-3xl gap-4 pt-4 pb-8 md:col-start-2 md:gap-5 md:pt-6 md:pb-12">
    <!-- The full stop must sit right after the underline, with no space before it, so Prettier leaves this alone. -->
    <!-- prettier-ignore -->
    <h1 class="m-0 text-4xl leading-[1.05] font-extrabold tracking-tight sm:text-5xl md:text-7xl">
      A product-minded frontend engineer who <span class="decoration-pen underline decoration-wavy decoration-[3px] underline-offset-[0.18em]">sweats the details</span>.
    </h1>
    <p class="text-text-muted m-0 max-w-xl text-base leading-relaxed sm:text-lg">
      Eighteen years between design and engineering. Here's what I've been building lately, with notes in the margin on
      what to look at.
    </p>
  </div>

  <section id="work" aria-labelledby="work-heading" class="col-span-full grid scroll-mt-4 grid-cols-subgrid">
    <h2 id="work-heading" class="sr-only">
      Work
    </h2>
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </section>
</Base>
