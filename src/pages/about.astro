---
import { Image } from 'astro:assets'
import headshot from '../assets/about/headshot.jpg'
import Icon from '../components/Icon.astro'
import MarginNote from '../components/MarginNote.astro'
import { resume } from '../data/resume'
import Base from '../layouts/Base.astro'
import { contact } from '../navigation'

const section = 'border-divider col-span-full grid grid-cols-subgrid border-t-2 border-dashed md:border-t-0'
const body = 'border-divider grid gap-5 pt-3 pb-10 md:col-start-2 md:border-t-2 md:border-dashed md:pt-8'
const h2 = 'm-0 text-2xl leading-tight font-extrabold tracking-tight md:text-3xl'
// The resume at a glance, from the resume itself: where the author works now, and where before.
const [current, ...earlier] = resume.experience
const before = earlier.map(({ company }) => company)
const glance = [
  {
    label: 'Experience',
    text: `18+ years. Now ${current.role} at ${current.company}, building its AI products. Before that, ${before.slice(0, -1).join(', ')} and ${before.at(-1)}.`,
  },
  { label: 'Focus', text: 'Frontend architecture, design systems, user experience and AI-driven products.' },
  { label: 'Stack', text: 'React, Vue, Next.js, Tailwind and Figma.' },
  { label: 'Education', text: `${resume.education.degree}, ${resume.education.school}.` },
]
---

<Base
  title="About · Mikel McCormick"
  description="About Mikel McCormick, a product-minded frontend engineer with 18 years between design and engineering, and life outside of work."
>
  <MarginNote arrow>that's me</MarginNote>
  <header class="grid gap-10 pt-6 pb-12 md:col-start-2 lg:grid-cols-[minmax(0,42rem)_18rem] lg:items-start lg:gap-14">
    <div class="grid gap-5">
      <h1 class="m-0 text-5xl leading-none font-extrabold tracking-tight md:text-7xl">About me</h1>
      <p class="m-0 text-lg leading-relaxed">
        I'm a software engineer with 18+ years of experience building web applications, shaping user experiences, and
        improving the systems behind them. My work spans frontend architecture, UX and UI design, design systems, and
        AI-powered products.
      </p>
      <p class="m-0 text-lg leading-relaxed">
        I've spent much of my career working between design and engineering. I enjoy taking an early product idea,
        working through the interaction and technical details, and turning it into software that is useful,
        maintainable, and good to use.
      </p>
    </div>
    <!-- Taped into the notebook, like a print: beside the introduction, or above it on a narrow screen, by "that's me". -->
    <figure class="relative order-first m-0 mt-3 w-60 rotate-2 justify-self-center md:w-72 lg:order-none lg:mt-4 lg:justify-self-end">
      <span
        class="bg-tape absolute -top-3 left-1/2 h-7 w-24 -translate-x-1/2 -rotate-3 opacity-80 shadow-sm"
        aria-hidden="true"
      ></span>
      <div class="border-edge bg-card rounded-sm border p-2.5 pb-3 shadow-md">
        <Image
          src={headshot}
          alt="Mikel McCormick, smiling, with glasses and a beard, in front of a plant and a bookshelf."
          width={288}
          widths={[240, 288, 480, 576]}
          sizes="(min-width: 48rem) 17rem, 14rem"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div>
    </figure>
  </header>

  <section class={section} aria-labelledby="outside-work">
    <MarginNote>off the clock</MarginNote>
    <div class={body}>
      <h2 id="outside-work" class={h2}>
        Outside of work
      </h2>
      <p class="m-0 max-w-2xl text-lg leading-relaxed">
        Most of my life outside of work happens at home with Brittany, my wife of five years. We have two dogs and four
        cats. Hank is our two-year-old Bernese Mountain Dog and Oakley is our six-month-old golden retriever.
      </p>
      <p class="m-0 max-w-2xl text-lg leading-relaxed">
        I like making things with my hands, and furniture is my favorite thing to build. Around the house I like custom
        carpentry and built-ins best, along with trim work and electrical. Some of my favorite projects have been for
        the animals: a 10-foot sandbox for the dogs and a custom catio for the cats. I'm also a foodie and a passionate
        home chef. My favorites to cook are Mexican, Chinese and Japanese.
      </p>
      <p class="m-0 max-w-2xl text-lg leading-relaxed">
        Outside, I garden with a focus on sustainable wildlife gardens and food forest design. I plant so the yard gives
        wildlife food and shelter, and layer trees, shrubs and perennials into something that feeds us too. It goes hand
        in hand with my interest in homesteading: growing and making more of what we use ourselves.
      </p>
      <p class="m-0 max-w-2xl text-lg leading-relaxed">
        Photography is another form of creative expression for me, and landscapes and abstract macro are my favorite
        subjects. I also make mixed-media art that combines illustration with pens, markers, watercolor and acrylic. I
        dabble in stencil art too.
      </p>
    </div>
  </section>

  <section class={section} aria-labelledby="how-i-work">
    <MarginNote>how I work</MarginNote>
    <div class={body}>
      <h2 id="how-i-work" class={h2}>
        How I work
      </h2>
      <p class="m-0 max-w-2xl text-lg leading-relaxed">
        I like solving problems that cross the boundary between design and engineering. Sometimes that means getting
        into the details of an interaction. Other times, it means stepping back to improve the architecture or establish
        a reusable pattern that makes future work easier.
      </p>
      <p class="m-0 max-w-2xl text-lg leading-relaxed">
        I'm comfortable working independently, getting up to speed in an unfamiliar codebase, and taking a problem from
        an early idea through production. I value clear communication, sound technical decisions, and software that
        works well for the people who depend on it.
      </p>
    </div>
  </section>

  <section class={section} aria-labelledby="resume">
    <MarginNote>the resume</MarginNote>
    <div class={body}>
      <h2 id="resume" class={h2}>
        Resume
      </h2>
      <p class="m-0 max-w-2xl text-lg leading-relaxed">{resume.title}.</p>
      <dl class="m-0 grid max-w-2xl">
        {glance.map(({ label, text }) => (
          <div class="border-edge grid gap-1 border-t py-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
            <dt class="text-text-muted text-sm font-semibold tracking-wider uppercase sm:pt-1">{label}</dt>
            <dd class="m-0 text-lg leading-relaxed">{text}</dd>
          </div>
        ))}
      </dl>
      <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
        <li>
          <a href="/resume" class="decoration-pen inline-flex min-h-11 items-center gap-2 font-semibold decoration-2">
            <Icon name="document" />
            See full resume
          </a>
        </li>
        <li>
          <a
            href={resume.pdf}
            class="decoration-pen inline-flex min-h-11 items-center gap-2 font-semibold decoration-2"
          >
            <Icon name="download" />
            Download as PDF
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class={section} aria-labelledby="contact">
    <MarginNote>get in touch</MarginNote>
    <div class={body}>
      <h2 id="contact" class={h2}>
        Contact
      </h2>
      <ul class="m-0 grid list-none gap-2 p-0 text-lg">
        <!-- The icon names the service to the eye; the hidden label names it to a screen reader. -->
        <li class="flex items-center gap-3">
          <Icon name="email" class="text-text-muted" />
          <span class="sr-only">Email:</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li class="flex items-center gap-3">
          <Icon name="linkedin" class="text-text-muted" />
          <span class="sr-only">LinkedIn:</span>
          <a href={contact.linkedin}>mikel-mccormick-b054b445</a>
        </li>
        <li class="flex items-center gap-3">
          <Icon name="github" class="text-text-muted" />
          <span class="sr-only">GitHub:</span>
          <a href={contact.github}>magicianmike</a>
        </li>
      </ul>
    </div>
  </section>
</Base>
