---
import { Font } from 'astro:assets'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

// The page's link preview image, made by `pages/og` from the same path, or `index` for the home page.
const path = Astro.url.pathname.replace(/^\/|\/$/g, '')
const ogImage = new URL(`/og/${path || 'index'}.png`, Astro.site)
const canonical = new URL(Astro.url.pathname, Astro.site)

// Vercel Web Analytics (ADR 0004), only in Vercel's own builds: anywhere else its script isn't served, and the 404
// would show as a console error. It's cookieless, so there's no consent banner.
const analytics = !!process.env.VERCEL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mikel McCormick" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- A theme the Visitor chose, applied before the first paint so the page never flashes the other one. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {
        // Storage blocked: follow the system.
      }
    </script>
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-plex" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-caveat" />
    {analytics && (
      <>
        <script is:inline>
          window.va =
            window.va ||
            function (...args) {
              ;(window.vaq = window.vaq || []).push(args)
            }
        </script>
        <script is:inline defer src="/_vercel/insights/script.js" />
      </>
    )}
  </head>
  <body>
    <a
      href="#main"
      class="bg-paper sr-only z-10 rounded px-3 py-2 font-semibold focus:not-sr-only focus:absolute focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <SiteHeader />
      <!--
        The page: a margin column for handwritten notes, a red margin line, then the text. The line starts below the
        header, so it never runs through the name. On a narrow screen the margin goes, the line moves to the edge,
        and the notes sit above what they're about.
      -->
      <div class="before:bg-margin-line relative grid grid-cols-1 pl-3 before:absolute before:inset-y-0 before:left-0 before:w-0.5 md:grid-cols-[var(--spacing-margin)_minmax(0,1fr)] md:gap-x-8 md:pl-0 md:before:left-[calc(var(--spacing-margin)+0.9rem)]">
        <main id="main" tabindex="-1" class="col-span-full grid grid-cols-subgrid outline-none">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
  </body>
</html>
